{
  "name": "lineputscript",
  "displayName": "LinePutScript",
  "description": "LinePutScript-Formatter",
  "publisher": "Hakoyu",
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.81.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hakoyu/LinePutScript-Formatter"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:lineputscript.format",
    "onLanguage:lps"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lineputscript.format",
        "title": "LinePutScript Format"
      }
    ],
    "languages": [
      {
        "id": "lps",
        "aliases": [
          "lps",
          "lps"
        ],
        "extensions": [
          ".lps"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lps",
        "scopeName": "source.lps",
        "path": "./syntaxes/lps.tmLanguage.json"
      }
    ],
    "configuration": [
      {
        "title": "LinePutScript Formatter",
        "properties": {
          "lineputscript.lineFeedThreshold": {
            "type": "number",
            "description": "Legacy line feed threshold. Compact formatting does not wrap lines.",
            "default": 64
          },
          "lineputscript.formatterSwitch": {
            "type": "boolean",
            "description": "Enable LinePutScript document formatting.",
            "default": false
          },
          "lineputscript.maxFormatDocumentSize": {
            "type": "number",
            "description": "Maximum LPS document size in characters that the formatter will process.",
            "default": 1048576
          },
          "lineputscript.languageServiceSwitch": {
            "type": "boolean",
            "description": "Enable LinePutScript hover, completion, diagnostics, and document symbols.",
            "default": true
          },
          "lineputscript.lazyLanguageService": {
            "type": "boolean",
            "description": "Use visible-range and cursor-based parsing for LinePutScript language features.",
            "default": true
          },
          "lineputscript.maxLanguageServiceDocumentSize": {
            "type": "number",
            "description": "Maximum document size in characters before document-wide language features use lazy large-file behavior.",
            "default": 1048576
          },
          "lineputscript.diagnosticVisibleBufferLines": {
            "type": "number",
            "description": "Number of lines before and after visible ranges to include in lazy diagnostics.",
            "default": 50
          },
          "lineputscript.backgroundIndexTimeBudgetMs": {
            "type": "number",
            "description": "Maximum milliseconds spent per background name-indexing chunk.",
            "default": 8
          },
          "lineputscript.maxDocumentSymbolsForLargeFile": {
            "type": "number",
            "description": "Maximum LPS line symbols returned for document symbol requests.",
            "default": 2000
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "mocha ./out/**/*.test.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.81.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
