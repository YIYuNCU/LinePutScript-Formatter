{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LinePutScript",
  "scopeName": "source.lps",
  "patterns": [
    {
      "include": "#lineComment"
    },
    {
      "include": "#continuation"
    },
    {
      "include": "#separator"
    },
    {
      "include": "#escape"
    },
    {
      "include": "#lineName"
    },
    {
      "include": "#subName"
    },
    {
      "include": "#info"
    }
  ],
  "repository": {
    "lineComment": {
      "name": "comment.line.triple-slash.lps",
      "match": "///.*$"
    },
    "continuation": {
      "patterns": [
        {
          "name": "constant.character.newline-text-marker.lps",
          "match": "^\\|"
        },
        {
          "name": "constant.character.newline-continuation-marker.lps",
          "match": "^:"
        }
      ]
    },
    "separator": {
      "patterns": [
        {
          "name": "punctuation.separator.sub.lps",
          "match": ":\\|"
        },
        {
          "name": "punctuation.separator.info.lps",
          "match": "#"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.lps",
      "match": "/(?:stop|equ|tab|n|r|id|com|!|\\|)(?![A-Za-z0-9_])"
    },
    "lineName": {
      "name": "entity.name.section.line.lps",
      "match": "^[^#:\\|/\\n]+"
    },
    "subName": {
      "name": "variable.other.sub.lps",
      "match": "(?<=:\\|)[^#:\\|\\n]+(?=#|:\\|)"
    },
    "info": {
      "patterns": [
        {
          "name": "constant.numeric.lps",
          "match": "(?<=#)-?\\d+(?:\\.\\d+)?(?=:\\||///|$)"
        },
        {
          "name": "string.unquoted.info.lps",
          "match": "(?<=#)[^:\\|\\n]*(?=:\\||///|$)"
        }
      ]
    }
  }
}
